scn QstS

; # Defined by ini
short featureBleed
float startBleedHealthPercentage
float secondsUntilDeathFromBleedHealthPercentage
short bDisallowRestWhileBleeding
short featureRegen
float startRegenHealthPercentage
float secondsUntilFullHealthFromRegenHealthPercentage
short bPrintToConsole
short bShouldLogWarning
short bShouldLogDebug
short bShouldLogFlooding
float neutralizefGlobalTimeMultiplier
short featureSleepWaitHealing
float durationOfRecentlyRested
short bHealOnWait
;
short bInit
float fQuestDelayTime
float startBleedHealthFraction
float startRegenHealthFraction
int iInitDelay
float xMax
float fRecentlySleptTimer
float secondsPassed
int bShouldSetHealthAfterSleepOrWait
float fPreviousHealth


begin _GameMode
	Call Init
	; SleepWaitHealing
	if eval featureSleepWaitHealing
		if eval bShouldSetHealthAfterSleepOrWait
			if eval bShouldLogDebug
				Call LogTH "bShouldSetHealthAfterSleepOrWait:" + $bShouldSetHealthAfterSleepOrWait
			endif
			let bShouldSetHealthAfterSleepOrWait := 0
			
			if eval !player.HasSpell RecentlySlept
				if eval bShouldLogDebug
					Call LogTH "Adding health because: has not slept recently."
				endif
				player.AddSpell RecentlySlept
				let fRecentlySleptTimer := durationOfRecentlyRested
				let xMax := (Call CFGetAVMax PlayerRef avcHealth)
				Call CFSetAVCurrent playerRef avcHealth Call CFMin xMax fPreviousHealth + 0.3 * xMax
			else
				if eval bShouldLogDebug
					Call LogTH "Setting to previous health because: already slept recently."
				endif
				Call CFSetAVCurrent playerRef avcHealth fPreviousHealth
			endif
		endif
		; RecentlySlept removal by timer
		if eval (neutralizefGlobalTimeMultiplier != 0)
			Let secondsPassed := GetSecondsPassed / neutralizefGlobalTimeMultiplier
		else
			Let secondsPassed := GetSecondsPassed
		endif
		if eval (fRecentlySleptTimer -= secondsPassed) < 0
			player.RemoveSpell RecentlySlept
			if eval bShouldLogDebug
				Call LogTH "Removing Spell. fRecentlySleptTimer:" +$fRecentlySleptTimer
			endif
		else
			if eval bShouldLogFlooding
				Call LogTH "fRecentlySleptTimer:" + $fRecentlySleptTimer
			endif
		endif
		;
		let fPreviousHealth := Call CFGetAVCurrent PlayerRef avcHealth
	endif
end

Begin MenuMode 1012
	; Detect if sleep or wait occurred
	if eval featureSleepWaitHealing
		if eval IsTimePassing == 1 && (bHealOnWait || IsPCSleeping)
			if eval bShouldLogFlooding
				Call LogTH "Sleep or wait detected"
			endif
			let bShouldSetHealthAfterSleepOrWait := 1
		endif
	endif
End
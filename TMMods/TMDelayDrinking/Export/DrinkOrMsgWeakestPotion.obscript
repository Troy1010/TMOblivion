scn DrinkOrMsgWeakestPotion
; This script is not refined for performance or readability.

int eMagicEffect
; 1: REHE. Restore Health.
; 2: RESP. Restore Mana.
; 3: REFA. Restore Fatigue.
ref rItem
ref rWeakestPotionBase
long lAmount
long i
long lEffectCount
int targetMagicEffectCode
int bOnlyMsgForNoHits

Begin _Function { eMagicEffect bOnlyMsgForNoHits }
    let rWeakestPotionBase := Call FindBaseOfWeakestPotion eMagicEffect
	Call LogDD "rWeakestPotionBase:"+$rWeakestPotionBase
	if eval rWeakestPotionBase
		if eval !bOnlyMsgForNoHits
			player.EquipItem rWeakestPotionBase
		endif
	else
		if eval eMagicEffect == 1
			MessageEX "No Health Potions"
		elseif eval eMagicEffect == 2
			MessageEX "No Magicka Potions"
		elseif eval eMagicEffect == 3
			MessageEX "No Fatigue Potions"
		endif
	endif
End
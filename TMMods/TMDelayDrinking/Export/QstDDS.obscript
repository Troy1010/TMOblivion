scn QstDDS
; This script is not refined for performance or readability.

; Defined by ini
int featureDelayDrinks
int bPrintToConsole
int bShouldLogFlooding
int featurePassOutPotions
float fDelayTime
;
int bInit
float fQuestDelayTime
float timer
int ePressType
; 1: Health Potion
; 2: Magicka Potion
; 3: Fatigue Potion
; 4: Poison
; 5: Menu
int ePreviousPressType
ref rTarget
ref rPotion
ref rTemp


begin _GameMode
	Call Init
	DisableControl 15; Menu; I'm not sure if there is a better command for this.
	if eval QstDD.featureDelayDrinks
		if eval OnControlDown2_ByRef CONTROLHealthPotion
			if eval featurePassOutPotions && IsKeyPressed3 42;TODO: Is there some other way to handle shift?
				Call LogDD "HealthPotion pressed with modifier"
				let rTarget := GetCrosshairRef
				; Use potion on target
				;Validate target
				if eval rTarget.GetDead
					Call LogDD "rTarget not valid. rTarget.GetDead:"+$rTarget.GetDead
				else
					;Validate if potion exists
					let rPotion := Call FindBaseOfWeakestPotion 1
					if eval !rPotion
						Call LogDD "No Health Potions"
						MessageEX "No Health Potions"
					else
						;Remove potion
						player.RemoveItem rPotion 1
						;Add potion to target
						rTarget.AddItem rPotion 1
						;Target uses potion
						rTarget.EquipItem rPotion
					endif
				endif
			else
				Call LogDD "HealthPotion pressed"
				Let timer := fDelayTime
				let ePressType := 1
				Call DrinkOrMsgWeakestPotion ePressType 1
			endif
		endif
		if eval OnControlDown2_ByRef CONTROLMagickaPotion
			Call LogDD "MagickaPotion pressed"
			Let timer := fDelayTime
			let ePressType := 2
			Call DrinkOrMsgWeakestPotion ePressType 1
		endif
		if eval (OnControlDown2 15);Menu
			Call LogDD "OnControlDown2 15"
			Let timer := fDelayTime
			let ePressType := 5
		endif
	endif
	if eval ePressType != 0
		if eval ePressType == 1
			if eval IsEngaged_ByRef CONTROLHealthPotion
				if eval (timer -= GetSecondsPassed) < 0
					Call DrinkOrMsgWeakestPotion ePressType 0
					let ePressType := 0
				endif
			else
				Call LogDD "HealthPotion no longer engaged"
				let ePressType := 0
			endif
		elseif eval ePressType == 2
			if eval IsEngaged_ByRef CONTROLMagickaPotion
				if eval (timer -= GetSecondsPassed) < 0
					Call DrinkOrMsgWeakestPotion ePressType 0
					let ePressType := 0
				endif
			else
				Call LogDD "MagickaPotion no longer engaged"
				let ePressType := 0
			endif
		elseif eval ePressType == 5
			if eval (IsEngaged 15);Menu
				Call LogDD "Menu being pressed"
				if eval (timer -= GetSecondsPassed) < 0
					Call LogDD "Menu pressed for duration"
					TapControl 15;Menu
					let ePressType := 0
				endif
			else
				Call LogDD "Menu no longer engaged"
				let ePressType := 0
			endif
		endif
	endif
	if eval ePressType != ePreviousPressType
		if eval ePreviousPressType != 0 && ePressType == 0
			EnableControls ar_List ControlIDForward ControlIDLeft ControlIDBack ControlIDRight ControlIDAttack ControlIDBlock ControlIDActivate ControlIDCast ControlIDSeathWeapon ControlIDAutoMove ControlIDJump
		endif
		if eval ePreviousPressType == 0 && ePressType != 0
			DisableControls ar_List ControlIDForward ControlIDLeft ControlIDBack ControlIDRight ControlIDAttack ControlIDBlock ControlIDActivate ControlIDCast ControlIDSeathWeapon ControlIDAutoMove ControlIDJump
		endif
		let ePreviousPressType := ePressType
	endif
end

begin _MenuMode
	Call Init
	EnableControl 15; Menu; I'm not sure if there is a better command for this.
end
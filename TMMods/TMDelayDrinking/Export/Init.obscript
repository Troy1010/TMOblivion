scn Init

begin _Function { }
	if eval GetGameLoaded || !QstDD.bInit
		;if eval !QstDD.bInit
		;	Call NoFlagDisable "Menu"
		;endif
		Call NoFlagDisable "Menu" ; idk if this should be done some other way.
		Let QstDD.bInit := 1
		Let QstDD.fQuestDelayTime := 0.0001 ; TODO: I'm not sure if this is the number I usually use here.
		RunBatchScript "Data\ini\TMDelayDrinking.ini", 0, 1
		Call LogDD "Init"
	endif
end